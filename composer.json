{
    "name": "max-messenger-bot/max-bot-api-laravel",
    "description": "Max messenger Bot & Api (Laravel)",
    "keywords": [
        "max",
        "messenger",
        "bot",
        "api",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "MaxMessenger\\Laravel\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Eugene Makhaev",
            "email": "mj4444@mail.ru"
        }
    ],
    "support": {
        "email": "mj4444@mail.ru",
        "chat": "https://t.me/mj4444ru"
    },
    "require": {
        "php": "^8.2",
        "illuminate/config": "*",
        "illuminate/console": "*",
        "illuminate/database": "*",
        "illuminate/http": "*",
        "illuminate/log": "*",
        "illuminate/support": "*",
        "max-messenger-bot/max-bot-api-php": "~0.1.1",
        "mj4444/simple-http-client": "~0.2.0"
    },
    "require-dev": {
        "vimeo/psalm": "^6.16"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "MaxMessenger\\Laravel\\Providers\\MaxServiceProvider"
            ],
            "aliases": {
                "MaxApi": "MaxMessenger\\Laravel\\Facades\\MaxApi"
            }
        }
    }
}
